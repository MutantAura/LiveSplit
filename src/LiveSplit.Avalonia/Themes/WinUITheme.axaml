<!--
  WinUI 3 (Windows 11 Fluent 2) look, layered on top of Avalonia's Fluent theme.
  Colors follow the WinUI 3 default palette: Mica Alt window backgrounds, layered control
  fills, the default Windows accent ramp, 4px control and 8px overlay corner radii and the
  Segoe UI Variable font.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveSplit.Themes.WinUITheme">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#0078D4</Color>
          <Color x:Key="SystemAccentColorDark1">#005FB8</Color>
          <Color x:Key="SystemAccentColorDark2">#004275</Color>
          <Color x:Key="SystemAccentColorDark3">#002642</Color>
          <Color x:Key="SystemAccentColorLight1">#429CE3</Color>
          <Color x:Key="SystemAccentColorLight2">#76B9ED</Color>
          <Color x:Key="SystemAccentColorLight3">#A6D8FF</Color>

          <!-- Mica Alt. Fluent paints windows with SystemRegionBrush. -->
          <Color x:Key="SystemRegionColor">#F3F3F3</Color>
          <SolidColorBrush x:Key="SystemRegionBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#1B1B1B" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#5F5F5F" />

          <SolidColorBrush x:Key="ButtonBackground" Color="#FBFBFB" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F6F6F6" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#F5F5F5" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#F5F5F5" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#E5E5E5" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#E5E5E5" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#E5E5E5" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#1B1B1B" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1B1B1B" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#5F5F5F" />

          <SolidColorBrush x:Key="AccentButtonBackground" Color="#005FB8" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#1A6FC0" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#3380C6" />
          <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#0A63B9" />
          <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#1E72C2" />
          <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#3380C6" />
          <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#CFE2F3" />

          <SolidColorBrush x:Key="TextControlBackground" Color="#FBFBFB" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F6F6F6" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#E5E5E5" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#E0E0E0" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#005FB8" />

          <SolidColorBrush x:Key="ComboBoxBackground" Color="#FBFBFB" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F6F6F6" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#F5F5F5" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#E5E5E5" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#E5E5E5" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F9F9F9" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#E0E0E0" />

          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#005FB8" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#1A6FC0" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#3380C6" />

          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F9F9F9" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#E0E0E0" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#EDEDED" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#F0F0F0" />

          <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#EAEAEA" />
          <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#E5E5E5" />
          <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#E0E0E0" />
          <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#DADADA" />

          <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#5F5F5F" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#1B1B1B" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#1B1B1B" />
          <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#005FB8" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#0078D4</Color>
          <Color x:Key="SystemAccentColorDark1">#005A9E</Color>
          <Color x:Key="SystemAccentColorDark2">#004275</Color>
          <Color x:Key="SystemAccentColorDark3">#002642</Color>
          <Color x:Key="SystemAccentColorLight1">#429CE3</Color>
          <Color x:Key="SystemAccentColorLight2">#60CDFF</Color>
          <Color x:Key="SystemAccentColorLight3">#99EBFF</Color>

          <!-- Mica Alt. Fluent paints windows with SystemRegionBrush. -->
          <Color x:Key="SystemRegionColor">#202020</Color>
          <SolidColorBrush x:Key="SystemRegionBrush" Color="#202020" />
          <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#202020" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#C5C5C5" />

          <SolidColorBrush x:Key="ButtonBackground" Color="#2D2D2D" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#323232" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#272727" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#2A2A2A" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#353535" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#353535" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#303030" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C5C5C5" />

          <SolidColorBrush x:Key="AccentButtonBackground" Color="#60CDFF" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#5AB9E5" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#50A5CC" />
          <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#6DD1FF" />
          <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#66BEE7" />
          <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#50A5CC" />
          <SolidColorBrush x:Key="AccentButtonForeground" Color="#000000" />
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#000000" />
          <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#1F3D4C" />

          <SolidColorBrush x:Key="TextControlBackground" Color="#2D2D2D" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#323232" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1F1F1F" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3A3A3A" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3F3F3F" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#60CDFF" />

          <SolidColorBrush x:Key="ComboBoxBackground" Color="#2D2D2D" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#323232" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#272727" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#353535" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#353535" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2C2C2C" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#404040" />

          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#60CDFF" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#5AB9E5" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#50A5CC" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#000000" />

          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#2C2C2C" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#404040" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#383838" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#333333" />

          <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#2D2D2D" />
          <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#353535" />
          <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#3A3A3A" />
          <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#404040" />

          <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#C5C5C5" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#60CDFF" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>

      <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
      <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI, fonts:Inter#Inter</FontFamily>
      <!-- WinUI 3 uses compact, body-sized tab headers (SelectorBar) instead of large pivots. -->
      <x:Double x:Key="TabItemHeaderFontSize">14</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button, ToggleButton, RepeatButton">
    <Setter Property="Padding" Value="11,5,11,6" />
  </Style>

</Styles>
