<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LiveSplit</RootNamespace>
    <AssemblyName>LiveSplit.Avalonia</AssemblyName>
    <ApplicationIcon>../LiveSplit/Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="../LiveSplit/Icon.ico" Link="Assets/Icon.ico" />
    <EmbeddedResource Include="$(SrcPath)/LiveSplit.View/Resources/DefaultLayout.lsl" LogicalName="LiveSplit.DefaultLayout.lsl" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LiveSplit.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SrcPath)/LiveSplit.Avalonia.Core/LiveSplit.Avalonia.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
  </ItemGroup>

</Project>
